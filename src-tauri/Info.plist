<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Minimal Library looks for Sonos and DLNA speakers on your home network to play music there.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_sonos._tcp</string>
  </array>
  <key>NSAppleEventsUsageDescription</key>
  <string>Minimal Library uses the Finder to put deleted files back from the Trash.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Only to show the names of audio output devices. Nothing is recorded.</string>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>de</string>
  </array>
</dict>
</plist>
