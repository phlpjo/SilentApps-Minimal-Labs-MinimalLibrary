{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minimal Library",
  "version": "1.0.0",
  "identifier": "de.philipdecker.minimallibrary",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Minimal Library",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "dragDropEnabled": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "SilentApps Minimal Labs",
    "copyright": "© 2026 Philip Decker",
    "category": "Music",
    "shortDescription": "Musikbibliothek: sortieren, taggen, Duplikate, Playlisten",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "English",
          "German"
        ],
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "de-DE"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCOTA4NzJCNjIxNjE4Q0QKUldUTkdCWmlLNGVRdXlITVFHQm5xL3NCaXhkRTlKMjNLdEN2TDBjMllZblhSTVlYb2JlZGE4dmEK",
      "endpoints": [
        "https://silentapps-minimal-labs.com/api/update/minimal-library/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "minimallibrary"
        ]
      }
    }
  }
}